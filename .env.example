# 复制本文件为 `.env` 后按需填写。
# 默认配置会读取这里的变量；不要把真实密钥提交到 Git。

# 默认大模型与 embedding 密钥。
# 当前 `config/agent.yaml` 默认使用 `qwen`，它在 `config/providers.yaml` 中读取 `OPENAI_API_KEY`。
# 如果使用默认 DashScope 兼容端点，这里填写阿里云百炼 / DashScope 兼容 OpenAI API 的 key。
OPENAI_API_KEY=your-openai-or-dashscope-compatible-api-key

# 飞书机器人凭据。
# 运行 `--mode gateway`、`--mode all` 或 `agent.gateway.main` 时需要填写。
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Tavily 网页搜索密钥。
# 填写后 `web_search` 会优先使用 Tavily；不填写时自动使用 DuckDuckGo 兜底。
TAVILY_API_KEY=your-tavily-api-key
